<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_line_pricelist" model="ir.ui.view">
        <field name="name">sale.order.form.line.pricelist</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="is_expense" column_invisible="1"/>
                <field name="line_pricelist_id" optional="show"
                       placeholder="Lista del pedido"
                       domain="[('currency_id', '=', parent.currency_id), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="display_type or is_downpayment or is_expense or combo_item_id"
                       readonly="qty_invoiced != 0 or parent.locked or parent.state == 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="is_expense" invisible="1"/>
                <field name="combo_item_id" invisible="1"/>
                <field name="line_pricelist_id" placeholder="Lista del pedido"
                       domain="[('currency_id', '=', parent.currency_id), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="display_type or is_downpayment or is_expense or combo_item_id"
                       readonly="qty_invoiced != 0 or parent.locked or parent.state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
